msgid "Vous ne disposez pas de la permission requise."
msgstr "You do not have the required permission."

msgid "Vous devez modifier votre mot de passe avant de continuer."
msgstr "You must change your password before continuing."

msgid "Vous devez modifier votre mot de passe depuis l’application Web."
msgstr "You must change your password from the Web application."

msgid "Les données envoyées sont invalides."
msgstr "The submitted data is invalid."

msgid "Le refresh token est obligatoire."
msgstr "The refresh token is required."

msgid "Refresh token invalide."
msgstr "Invalid refresh token."

msgid "Déconnexion effectuée."
msgstr "You have been logged out."

msgid "Produit introuvable."
msgstr "Product not found."

msgid "Seule l’unité de base est actuellement disponible."
msgstr "Only the base unit is currently available."

msgid "Une vente ou un achat doit contenir au moins un produit."
msgstr "A sale or purchase must contain at least one product."

msgid "Un produit est introuvable."
msgstr "A product could not be found."

msgid "Le prix ne peut pas être négatif."
msgstr "The price cannot be negative."

msgid "La remise ne peut pas être négative."
msgstr "The discount cannot be negative."

msgid "Impossible de vendre un produit à un prix inférieur à son prix d'achat."
msgstr "A product cannot be sold below its purchase price."

msgid "Stock insuffisant : %(available)s unité(s) disponible(s)."
msgstr "Insufficient stock: %(available)s unit(s) available."

msgid "Suppression impossible : cet élément est utilisé."
msgstr "This item cannot be deleted because it is in use."

msgid "Requête ralentie."
msgstr "Request throttled."
msgid "Conditionnement invalide ou inactif."
msgstr "Invalid or inactive packaging."

msgid "La conversion du conditionnement est incohérente."
msgstr "The packaging conversion is inconsistent."

msgid "Impossible de vendre un produit à un prix inférieur à son prix d'achat."
msgstr "A product cannot be sold below its purchase cost."

msgid "Le prix du conditionnement ne peut pas être inférieur à son coût d'achat."
msgstr "The packaging price cannot be lower than its purchase cost."

msgid "Aucune imprimante active configurée."
msgstr "No active printer is configured."

msgid "Langue d’impression invalide."
msgstr "Invalid printing language."

msgid "Largeur papier invalide."
msgstr "Invalid paper width."

msgid "La largeur papier doit être 58 ou 80 mm."
msgstr "Paper width must be 58 or 80 mm."

msgid "Ce protocole nécessite un adaptateur local dédié."
msgstr "This protocol requires a dedicated local adapter."

msgid "Test imprimante"
msgstr "Printer test"

msgid "Imprimantes"
msgstr "Printers"

msgid "Paramètres des imprimantes"
msgstr "Printer settings"

msgid "Conditionnements"
msgstr "Packagings"

msgid "Conditionnement"
msgstr "Packaging"

msgid "Facteur"
msgstr "Factor"

msgid "Actif"
msgstr "Active"

msgid "Inactif"
msgstr "Inactive"

msgid "Chargement…"
msgstr "Loading…"

msgid "Impossible de récupérer le prix du produit."
msgstr "Unable to retrieve the product price."

msgid "Sélectionnez d’abord un client."
msgstr "Select a customer first."

msgid "Unité de base"
msgstr "Base unit"

msgid "Le prix Super Gros ne peut pas être inférieur au prix d’achat."
msgstr "The super wholesale price cannot be lower than the purchase price."

msgid "Le prix Gros ne peut pas être inférieur au prix d’achat."
msgstr "The wholesale price cannot be lower than the purchase price."

msgid "Le prix Détail ne peut pas être inférieur au prix d’achat."
msgstr "The retail price cannot be lower than the purchase price."

msgid "Les tarifs doivent respecter l’ordre : Super Gros ≤ Gros ≤ Détail."
msgstr "Prices must follow this order: super wholesale ≤ wholesale ≤ retail."

msgid "Le prix d'achat ne peut pas être négatif."
msgstr "The purchase price cannot be negative."

msgid "Nom produit"
msgstr "Product name"

msgid "Marque"
msgstr "Brand"

msgid "Prix d'achat"
msgstr "Purchase price"

msgid "Prix Super Gros"
msgstr "Super wholesale price"

msgid "Prix Gros"
msgstr "Wholesale price"

msgid "Prix Détail"
msgstr "Retail price"

msgid "Référence achat"
msgstr "Purchase reference"

msgid "Fournisseur"
msgstr "Supplier"

msgid "TVA (%)"
msgstr "VAT (%)"

msgid "Quantité"
msgstr "Quantity"

msgid "Supprimer"
msgstr "Delete"

msgid "Enregistrer"
msgstr "Save"

msgid "Code-barres"
msgstr "Barcode"

msgid "Généré automatiquement"
msgstr "Automatically generated"

msgid "Nouveau produit"
msgstr "New product"

msgid "Créer le produit"
msgstr "Create product"

msgid "Produit créé avec succès"
msgstr "Product created successfully"

msgid "Ce produit existe déjà."
msgstr "This product already exists."

msgid "Erreur lors de la création"
msgstr "Error creating product"

msgid "Création produit depuis achat"
msgstr "Product created from purchase"

msgid "Nouvel achat"
msgstr "New purchase"

msgid "Ajouter un produit"
msgstr "Add a product"

msgid "Annuler"
msgstr "Cancel"

msgid "Latitude"
msgstr "Latitude"

msgid "Longitude"
msgstr "Longitude"

msgid "Précision GPS (m)"
msgstr "GPS accuracy (m)"

msgid "Précision GPS"
msgstr "GPS accuracy"

msgid "Adresse détectée"
msgstr "Detected address"

msgid "Identifiant Maps"
msgstr "Maps identifier"

msgid "Voir sur Maps"
msgstr "View on Maps"

msgid "La valeur doit être un nombre fini."
msgstr "Enter a finite number."

msgid "Coordonnée ou précision GPS invalide."
msgstr "Invalid coordinates or GPS accuracy."

msgid "Renseignez ensemble la latitude et la longitude."
msgstr "Enter both latitude and longitude."

msgid "La précision nécessite une position GPS."
msgstr "Accuracy requires a GPS position."

msgid "Trop de demandes. Veuillez patienter."
msgstr "Too many requests. Please wait."

msgid "Adresse indisponible. Vous pouvez conserver le GPS et saisir l’adresse manuellement."
msgstr "Address unavailable. Keep the GPS position and enter the address manually."

msgid "L’accès à votre position a été refusé."
msgstr "Access to your location was denied."

msgid "Impossible de déterminer votre position."
msgstr "Unable to determine your location."

msgid "La localisation a expiré. Veuillez réessayer."
msgstr "Location request timed out. Please try again."

msgid "La géolocalisation nécessite HTTPS et un navigateur compatible."
msgstr "Geolocation requires HTTPS and a compatible browser."

msgid "Recherche de votre position…"
msgstr "Finding your location…"

msgid "Confirmez ou annulez la position proposée avant d’enregistrer."
msgstr "Confirm or cancel the proposed location before saving."

msgid "La position GPS semble imprécise."
msgstr "The GPS position appears inaccurate."

msgid "Position confirmée. Enregistrez le formulaire pour la sauvegarder."
msgstr "Location confirmed. Save the form to store it."

msgid "Adresse détectée trop longue : conservez le GPS et adaptez l’adresse manuellement."
msgstr "The detected address is too long: keep the GPS position and edit the address manually."

msgid "Localisation du client (facultative)"
msgstr "Customer location (optional)"

msgid "Votre position est demandée uniquement au clic. Elle ne sera enregistrée qu’après confirmation et enregistrement du client."
msgstr "Your location is requested only when clicked. It is stored only after confirmation and saving the customer."

msgid "Utiliser ma position actuelle"
msgstr "Use my current location"

msgid "Confirmer cette adresse"
msgstr "Confirm this address"

msgid "Conserver le GPS et modifier manuellement"
msgstr "Keep GPS and edit manually"

msgid "Notes"
msgstr "Notes"

msgid "Ajouter un client"
msgstr "Add a customer"

msgid "Modifier le client"
msgstr "Edit customer"

msgid "Localisation en cours…"
msgstr "Finding your location…"

msgid "Adresse automatique indisponible. Saisissez l’adresse manuellement."
msgstr "Automatic address unavailable. Enter the address manually."

msgid "Position GPS peu précise. Vérifiez l’adresse proposée."
msgstr "GPS position is imprecise. Check the suggested address."

msgid "Adresse trouvée."
msgstr "Address found."

msgid "Localisation invalide. Réessayez le bouton de localisation."
msgstr "Invalid location. Try the location button again."

msgid "Veuillez autoriser l’accès à votre position pour récupérer automatiquement l’adresse."
msgstr "Please allow access to your location to retrieve the address automatically."

msgid "Impossible de récupérer votre position actuelle."
msgstr "Unable to retrieve your current location."

msgid "Votre position a été détectée, mais l’adresse n’a pas pu être récupérée."
msgstr "Your location was detected, but the address could not be retrieved."
