DJANGO_DEBUG=False
SECRET_KEY=replace-in-staging-secret-store
JWT_SIGNING_KEY=replace-with-a-distinct-64-character-staging-secret
DATABASE_URL=postgresql://staging-user:password@staging-host/staging-db?sslmode=require
ALLOWED_HOSTS=staging.example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com
CORS_ALLOWED_ORIGINS=https://staging-web.example.com
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
MEDIA_STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=replace-in-staging-secret-store
AWS_SECRET_ACCESS_KEY=replace-in-staging-secret-store
AWS_STORAGE_BUCKET_NAME=replace-with-staging-media-bucket
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
MEDIA_FILESYSTEM_PERSISTENT=False
